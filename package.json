{
    "name":  "financial-plan-project",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Ung dung ke hoach tai chinh ca nhan dung tu Mockup.xlsx",
    "scripts":  {
                    "test":  "npm run test:unit \u0026\u0026 npm run test:rules",
                    "test:unit":  "node --test \"tests/domain/**/*.test.js\"",
                    "test:rules":  "firebase emulators:exec --only firestore --project demo-financial-plan-test \"node --test --test-concurrency=1 tests/rules/firestore.rules.test.js tests/rules/repository.integration.test.js\"",
                    "dev":  "vite",
                    "build":  "vite build",
                    "test:e2e":  "firebase emulators:exec --only firestore,auth --project demo-financial-plan-test \"node tests/e2e/app.e2e.mjs\""
                },
    "dependencies":  {
                         "firebase":  "^13.1.0"
                     },
    "devDependencies":  {
                            "@firebase/rules-unit-testing":  "^6.0.0",
                            "playwright-core":  "^1.64.1",
                            "vite":  "^8.3.5"
                        },
    "overrides":  {
                      "@grpc/grpc-js":  "^1.14.7"
                  }
}

